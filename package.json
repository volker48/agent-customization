{
  "name": "agent-customization",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-headlong": "./pi-extensions/headlong/cli.ts",
    "pi-remote": "./pi-extensions/remote/cli.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "pnpm lint:core && pnpm lint:extra",
    "lint:core": "oxlint -c .oxlintrc.json pi-extensions opencode-plugins",
    "lint:extra": "oxlint -c .oxlintrc.json .opencode/plugins scripts tests",
    "format": "pnpm format:core && pnpm format:rule && pnpm format:config",
    "format:core": "oxfmt --write pi-extensions opencode-plugins",
    "format:rule": "oxfmt --write scripts/oxlint-no-record-unknown.mjs",
    "format:config": "oxfmt --write .oxlintrc.json package.json tsconfig.json",
    "format:check": "pnpm format:check:core && pnpm format:check:rule && pnpm format:check:config",
    "format:check:core": "oxfmt --write pi-extensions opencode-plugins && git diff -- pi-extensions/headlong && exit 1",
    "format:check:rule": "oxfmt --check scripts/oxlint-no-record-unknown.mjs",
    "format:check:config": "oxfmt --check .oxlintrc.json package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.mjs",
    "test:prolong": "vitest run tests/prolong-memory.test.ts tests/prolong-extension.test.ts tests/prolong-regressions.test.ts tests/prolong-verification.test.mjs",
    "test:headlong": "vitest run tests/headlong-*.test.ts tests/headlong-verification.test.mjs",
    "baseline:webfetch": "WEBFETCH_BASELINE=1 vitest run tests/webfetch.baseline.test.ts --reporter=verbose",
    "test:rtk": "vitest run tests/rtk.test.ts",
    "test:rtk:e2e": "RTK_E2E=1 vitest run tests/rtk.e2e.test.ts",
    "test:remote:e2e": "REMOTE_E2E=1 vitest run tests/remote.e2e.test.ts",
    "test:fusion": "vitest run tests/fusion.test.ts tests/fusion-*.test.ts",
    "test:fusion:e2e": "FUSION_E2E=1 vitest run tests/fusion.e2e.test.ts",
    "verify:rtk": "node scripts/verify-rtk-extension.mjs",
    "validate:rtk": "node scripts/verify-rtk-extension.mjs",
    "verify:prolong": "node --import tsx scripts/verify-prolong-extension.mjs",
    "verify:headlong": "node --import tsx scripts/verify-headlong-extension.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@number0/iroh": "1.0.0",
    "linkedom": "0.18.12",
    "qrcode-terminal": "0.12.0",
    "tsx": "4.22.4",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@opencode-ai/plugin": "1.1.4",
    "@types/node": "25.2.3",
    "oxfmt": "0.32.0",
    "oxlint": "1.47.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "pi": {
    "extensions": [
      "./pi-extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "subagents": {
      "agents": [
        "./pi-subagents/agents"
      ]
    }
  }
}
