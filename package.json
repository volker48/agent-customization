{
  "name": "agent-customization",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-remote": "./pi-extensions/remote/cli.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint pi-extensions opencode-plugins",
    "format": "oxfmt --write pi-extensions opencode-plugins package.json tsconfig.json",
    "format:check": "oxfmt --check pi-extensions opencode-plugins package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "baseline:webfetch": "WEBFETCH_BASELINE=1 vitest run tests/webfetch.baseline.test.ts --reporter=verbose",
    "test:rtk": "vitest run tests/rtk.test.ts",
    "test:rtk:e2e": "RTK_E2E=1 vitest run tests/rtk.e2e.test.ts",
    "test:remote:e2e": "REMOTE_E2E=1 vitest run tests/remote.e2e.test.ts",
    "test:fusion": "vitest run tests/fusion.test.ts",
    "test:fusion:e2e": "FUSION_E2E=1 vitest run tests/fusion.e2e.test.ts",
    "verify:rtk": "node scripts/verify-rtk-extension.mjs",
    "validate:rtk": "node scripts/verify-rtk-extension.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@number0/iroh": "1.0.0",
    "linkedom": "0.18.12",
    "qrcode-terminal": "0.12.0",
    "tsx": "4.22.4",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.2",
    "@earendil-works/pi-coding-agent": "0.80.2",
    "@earendil-works/pi-tui": "0.80.2",
    "@opencode-ai/plugin": "1.1.4",
    "@types/node": "25.2.3",
    "oxfmt": "0.32.0",
    "oxlint": "1.47.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "pi": {
    "extensions": [
      "./pi-extensions"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
